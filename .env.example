# ============================================================
# Enterprise Ops SLA Monitor — Environment Template
# ============================================================
# Copy this file to .env and fill in real values.
# The .env file is gitignored and MUST NOT be committed.
# ============================================================

# --- Database Credentials ---
POSTGRES_DB=sla_monitor
POSTGRES_USER=
POSTGRES_PASSWORD=

# --- MongoDB Credentials ---
MONGO_ROOT_USER=
MONGO_ROOT_PASSWORD=

# --- API Security ---
# Minimum 32 characters. Generate with: openssl rand -hex 32
API_KEY=

# --- CORS Allowed Origin (Angular Dashboard URL) ---
# Example: http://localhost:4200 or https://dashboard.yourdomain.com
CORS_ALLOWED_ORIGIN=http://localhost:4200
